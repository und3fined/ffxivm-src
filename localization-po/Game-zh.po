msgstr ""

msgctxt "c_fate_text_cfg,1725_StoryCh"
msgid "我见我执帕佳佳出现在了战场上，并向义军发起了挑衅，快去消灭敌军部队！"
msgstr ""

msgctxt "c_fate_text_cfg,1726_NameCh"
msgid "遭遇古代巨兽"
msgstr ""

msgctxt "c_fate_text_cfg,1726_StoryCh"
msgid "魔兽大队释放的古代巨兽正在战场上发狂，打倒图斑天龙！"
msgstr ""

msgctxt "c_fate_text_cfg,1727_NameCh"
msgid "与邪道术师一决胜负"
msgstr ""

msgctxt "c_fate_text_cfg,1727_StoryCh"
msgid "邪道术师准备在战场上进行残酷的实验，与前去迎击的洁白心罗菲一起打倒无心无惭法比诺！"
msgstr ""

msgctxt "c_fate_text_cfg,1728_NameCh"
msgid "通缉犯岁煞"
msgstr ""

msgctxt "c_fate_text_cfg,1728_StoryCh"
msgid "得到消息，协助帝国军的阴阳师是在东方遭到通缉的罪犯，快去消灭敌军部队！"
msgstr ""

msgctxt "c_fate_text_cfg,1729_NameCh"
msgid "仿制青龙壁的生命线"
msgstr ""

msgctxt "c_fate_text_cfg,1729_StoryCh"
msgid "博兹雅义军正打算对敌军物资储藏地发动突袭，收集军用桶装青磷水，交给小队长！"
msgstr ""

msgctxt "c_fate_text_cfg,1730_NameCh"
msgid "觉醒的强化兵"
msgstr ""

msgctxt "c_fate_text_cfg,1730_StoryCh"
msgid "机械化步兵大队的强化兵达波格操控无线制导兵器再次袭来，打倒加强版加百列δ！"
msgstr ""

