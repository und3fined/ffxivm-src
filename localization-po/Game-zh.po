msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59233900_DialogContent"
msgid ""
"<player>大人，欢迎光临。\n"
"\n"
"我们为老练的冒险者以及技艺高超的工匠\n"
"\n"
"准备了不少珍品。"
msgstr ""

msgctxt "c_default_dialog_cfg,59233901_DialogContent"
msgid "<blank>"
msgstr ""

