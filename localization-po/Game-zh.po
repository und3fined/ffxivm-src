msgctxt "c_fantasy_card_rule_cfg,5_PictureTitles_0"
msgid "继续对局"
msgstr ""

msgctxt "c_fantasy_card_rule_cfg,5_DetailedDesc"
msgid "出现平局时会以场上双方各自控制的卡片重新开始对局，直至分出胜负。若连续五局都是平局，则对战结束，结果为平局。"
msgstr ""

