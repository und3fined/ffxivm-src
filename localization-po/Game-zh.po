msgid ""
"<span color=\"#D1BA8EFF\">紧张感</>达到100或0时必定获得<span color=\"#D1BA8EFF\">【内静】</>状态。\n"
"<span color=\"#D1BA8EFF\">【内静】</>：<span color=\"#D1BA8EFF\">雕刻</>和<span color=\"#D1BA8EFF\">琢磨</>效率提高20%，持续3个工次。"
msgstr ""

msgctxt "c_skill_main_cfg,30512_SkillName"
msgid "乐观"
msgstr ""

msgctxt "c_skill_main_cfg,30513_Desc"
msgid ""
"<span color=\"#D1BA8EFF\">【内静】</>状态中<span color=\"#D1BA8EFF\">雕刻</>和<span "
"color=\"#D1BA8EFF\">琢磨</>的效率由提高20%改为提高40%。"
msgstr ""

msgctxt "c_skill_main_cfg,30513_SkillName"
msgid "稳手"
msgstr ""

msgctxt "c_skill_main_cfg,30530_Desc"
msgid ""
"<span color=\"#D1BA8EFF\">雕刻</>，<span color=\"#D1BA8EFF\">琢磨</>的最终值会受<span color=\"#D1BA8EFF\">紧张感</>影响，<span color=\"#D1BA8EFF\">紧张感</>越高，<span color=\"#D1BA8EFF\">琢磨</>波动越小，<span color=\"#D1BA8EFF\">雕刻</>波动越大。<span color=\"#D1BA8EFF\">紧张感</>越低，<span color=\"#D1BA8EFF\">琢磨</>波动越大，<span color=\"#D1BA8EFF\">雕刻</>波动越小。\n"
"当<span color=\"#D1BA8EFF\">紧张感</>在绿区时，获得<span color=\"#D1BA8EFF\">【松弛】</>效果——<span color=\"#D1BA8EFF\">进展</>效率提高50%。\n"
"当<span color=\"#D1BA8EFF\">紧张感</>在蓝区时，获得<span color=\"#D1BA8EFF\">【专注】</>效果——<span color=\"#D1BA8EFF\">品质</>效率提高50%。"
msgstr ""

