"很抱歉，现在还在准备中。"
msgstr ""

msgctxt "c_default_dialog_cfg,59064701_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59064702_DialogContent"
msgid "<blank>"
msgstr ""

