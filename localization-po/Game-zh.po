msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59208402_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59208500_DialogContent"
msgid ""
"啊，竟然输给你啦……\n"
"不过我玩得很开心。\n"
