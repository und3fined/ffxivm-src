msgctxt "c_default_dialog_cfg,59208001_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59208002_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59208100_DialogContent"
msgid ""
"没想到玩这个还挺吃力的……\n"
