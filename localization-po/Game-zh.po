msgctxt "c_levequest_cfg,1507_CityNPCTitle"
msgid "鬼哭队第五枪队队员"
msgstr ""

msgctxt "c_levequest_cfg,1508_QuestName"
msgid "制作委托：面向船员的衬衫"
msgstr ""

msgctxt "c_levequest_cfg,1508_QuestDesc"
