msgctxt "module,150025"
msgid ""
"作业台上的数值表示部位的<span color=\"#d1ba8e\">热度</>。点击4个区域中的任意一个可发动<span "
"color=\"#d1ba8e\">大力捶打</>，根据<span color=\"#d1ba8e\">热度</>同时提升<span "
"color=\"#d1ba8e\">进展</>与<span color=\"#d1ba8e\">品质</>"
msgstr ""

msgctxt "module,150026"
msgid ""
"<span color=\"#d1ba8e\">大力捶打</>后，当前部位的<span color=\"#d1ba8e\">热度</>会<span "
"color=\"#d1ba8e\">提高</>，相邻部位的<span color=\"#d1ba8e\">热度</>也会<span "
"color=\"#d1ba8e\">小幅提高</>"
msgstr ""

msgctxt "module,150027"
msgid ""
"<span "
"color=\"#d1ba8e\">热度</>也会通过部位的颜色展示，共有4档：1档（0-34），2档（35-69），3档（70-89），4档（90-100）"
msgstr ""

msgctxt "module,150028"
msgid ""
"当4个部位的<span color=\"#d1ba8e\">热度</>均达到2档（<span "
"color=\"#d1ba8e\">35</>以上），3档（<span color=\"#d1ba8e\">70</>以上），4档（<span "
"color=\"#d1ba8e\">90</>以上）时，即可发动<span color=\"#d1ba8e\">热锻</>——可大幅提升<span "
"color=\"#d1ba8e\">进展</>、<span color=\"#d1ba8e\">品质</>与<span "
"color=\"#d1ba8e\">热度</>。每次制作最多发动3次<span color=\"#d1ba8e\">热锻</>"
msgstr ""

