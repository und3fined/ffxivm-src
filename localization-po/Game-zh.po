msgid ""
"学会<span color=\"#ffeebb\">【兽魂】</>特性后，画面上会出现专用的<span "
"color=\"#ffeebb\">兽魂量谱</>。<span color=\"#ffeebb\">【裂石飞环】</>和40级学会的<span "
"color=\"#ffeebb\">【动乱】</>等技能都需要通过消耗积累的兽魂量值才能发动。兽魂量值可以通过发动普通攻击以及特定的技能进行累积。"
msgstr ""

msgctxt "c_guide_cfg,5_WindowContent_0"
msgid ""
"学会<span color=\"#ffeebb\">【兽魂】</>特性后，画面上会出现专用的指示兽魂值的<span "
"color=\"#ffeebb\">兽魂量谱</>。"
