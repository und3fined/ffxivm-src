msgctxt "c_default_dialog_cfg,59924302_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59924400_DialogContent"
msgid ""
"成为那些孩子的家人，\n"
"是我接下来的新目标……\n"
"你觉得我能实现吗？"
msgstr ""

