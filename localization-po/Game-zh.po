msgctxt "c_levequest_cfg,1509_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1510_QuestName"
msgid "筹集委托：面向工匠的裤子"
msgstr ""

msgctxt "c_levequest_cfg,1510_QuestDesc"
msgid "最近在乌尔达哈，有不少人都想学习工匠的手艺。因此工匠服装的销路很好。抓住此商机，为我们提供大量工作时穿的裤子。"
msgstr ""

msgctxt "c_levequest_cfg,1510_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1511_QuestName"
msgid "制作委托：护卫用的靴子"
msgstr ""

msgctxt "c_levequest_cfg,1511_QuestDesc"
msgid "我的主人格格鲁玖在利姆萨·罗敏萨的俾斯麦餐厅预定了晚餐会，届时随行的护卫也要穿着符合他们身份的衣装。请为我们提供棉绒的靴子。"
msgstr ""

msgctxt "c_levequest_cfg,1511_CityNPCTitle"
msgid "格格鲁玖商会管理员"
msgstr ""

msgctxt "c_levequest_cfg,1512_QuestName"
msgid "制作委托：流行的棉绒裤子"
msgstr ""

msgctxt "c_levequest_cfg,1512_QuestDesc"
msgid "在乌尔达哈的社交界，棉绒正在悄然流行起来。我们想抓住此商机，确保一定数量的棉绒裤子的库存。请有自信的裁衣匠助我们一臂之力。"
msgstr ""

msgctxt "c_levequest_cfg,1512_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1513_QuestName"
msgid "筹集委托：望远镜技师用的工作帽"
msgstr ""

msgctxt "c_levequest_cfg,1513_QuestDesc"
msgid "阿德内尔占星台为大型望远镜的维修技师订了工作帽。请认真为他们制作工作帽，保证在工作中头发不会掉到镜片上。"
msgstr ""

msgctxt "c_levequest_cfg,1513_CityNPCTitle"
msgid "酒保商人"
msgstr ""

msgctxt "c_levequest_cfg,1514_QuestName"
msgid "筹集委托：用于采集工作的裤子"
msgstr ""

msgctxt "c_levequest_cfg,1514_QuestDesc"
msgid "为备战，我等鬼哭队第五枪队认为有必要去森林里采集一些储备粮。衷心希望有能力制作用于采集工作的裤子的工匠来协助我们。"
msgstr ""

msgctxt "c_levequest_cfg,1514_CityNPCTitle"
msgid "鬼哭队第五枪队队员"
msgstr ""

msgctxt "c_levequest_cfg,1515_QuestName"
msgid "制作委托：出口用的朴素帽子"
msgstr ""

msgctxt "c_levequest_cfg,1515_QuestDesc"
msgid "我们要准备好商品，以便下次卖给格里达尼亚的幻术师们。请为我们提供大量格里达尼亚人喜爱的朴素帽子。请对自己有自信的裁衣匠帮我们制作。"
msgstr ""

msgctxt "c_levequest_cfg,1515_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1516_QuestName"
msgid "制作委托：防寒用的僧袍"
msgstr ""

msgctxt "c_levequest_cfg,1516_QuestDesc"
msgid "第七灵灾之后，库尔札斯的温度急速下降，成为了一个雪国。因此，能防风御寒的带帽僧袍成了必需品。请为他们制作能包裹全身的僧袍。"
msgstr ""

msgctxt "c_levequest_cfg,1516_CityNPCTitle"
msgid "酒保商人"
msgstr ""

msgctxt "c_levequest_cfg,1517_QuestName"
msgid "筹集委托：专属烹调师用的衣服"
msgstr ""

msgctxt "c_levequest_cfg,1517_QuestDesc"
msgid "宝石商人巴巴维想为在他府上工作的专属烹调师准备高级围裙装。他那里的烹调师人数不少，请提供大量长外衣。"
msgstr ""

msgctxt "c_levequest_cfg,1517_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1518_QuestName"
msgid "筹集委托：挖掘工人用的工作帽"
msgstr ""

msgctxt "c_levequest_cfg,1518_QuestDesc"
msgid "在挖掘在古代亚拉戈文明的遗迹时，会被四处飞散的粉尘和水晶碎片搞得灰头土脸。为此我们需要保护挖掘工人头部的帽子。请为我们提供大量呢绒制工作帽。"
msgstr ""

msgctxt "c_levequest_cfg,1518_CityNPCTitle"
msgid "圣寇伊纳克财团"
msgstr ""

msgctxt "c_levequest_cfg,1519_QuestName"
msgid "制作委托：法师用的宽边帽"
msgstr ""

msgctxt "c_levequest_cfg,1519_QuestDesc"
msgid "上次卖给格里达尼亚的帽子大受好评，因此硕老树冥想窟又向我们订了新帽子。我们要为法师这种特殊职业制作高级帽子。请有能力的裁衣匠来协助我们。"
msgstr ""

msgctxt "c_levequest_cfg,1519_CityNPCTitle"
msgid "圣寇伊纳克财团"
msgstr ""

msgctxt "c_levequest_cfg,1520_QuestName"
msgid "制作委托：博物学家用的长袍"
msgstr ""

msgctxt "c_levequest_cfg,1520_QuestDesc"
msgid "前几天，一位从萨雷安来的博物学家被地上的水晶刮破了衣服，她没带多少换洗衣服，请为她提供一件新的长袍。"
msgstr ""

msgctxt "c_levequest_cfg,1520_CityNPCTitle"
msgid "圣寇伊纳克财团"
msgstr ""

msgctxt "c_levequest_cfg,1601_QuestName"
msgid "制作委托：毒药的材料"
msgstr ""

msgctxt "c_levequest_cfg,1601_QuestDesc"
msgid "某位被称作制毒名人的炼金术士向我们订了水银。由于毒药卖得太好，因此他没有时间自己制作毒药的材料了。世道真是不太平，请为我们提供大量的水银。"
msgstr ""

msgctxt "c_levequest_cfg,1601_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1602_QuestName"
msgid "制作委托：植物成长促进剂"
msgstr ""

msgctxt "c_levequest_cfg,1602_QuestDesc"
msgid "为了使在灵灾时受伤的森林复苏，格里达尼亚的刻木匠行会向我们订了植物成长剂1型。请擅长炼金术的工匠助我们一臂之力。"
msgstr ""

msgctxt "c_levequest_cfg,1602_CityNPCTitle"
msgid "商队互助会"
msgstr ""

msgctxt "c_levequest_cfg,1603_QuestName"
msgid "制作委托：旅行商人的必需品"
msgstr ""

msgctxt "c_levequest_cfg,1603_QuestDesc"
msgid "对于游走各地的旅行商人来说，保持健康十分重要。因此解毒药是旅途中的必需品。为下次旅行做准备，请为我制作耐用的解毒药。"
msgstr ""

msgctxt "c_levequest_cfg,1603_CityNPCTitle"
msgid "商队互助会"
msgstr ""

msgctxt "c_levequest_cfg,1604_QuestName"
msgid "制作委托：初学者用的幻杖"
msgstr ""

msgctxt "c_levequest_cfg,1604_QuestDesc"
msgid "在一些经常前往危险地带的冒险者之间，流行起学习简单的治疗魔法。为此，面向初学者用的魔导典卖火了。为保证库存，请为我们提供枫木魔导典。"
msgstr ""

msgctxt "c_levequest_cfg,1604_CityNPCTitle"
msgid "商队互助会"
msgstr ""

msgctxt "c_levequest_cfg,1605_QuestName"
msgid "制作委托：面向咒术师行会的以太药"
msgstr ""

msgctxt "c_levequest_cfg,1605_QuestDesc"
msgid "咒术师行会向我们订了以太药。那帮人付款很慢，说实话我不想和他们做生意……但我们已交往甚久，不好拒绝。请为我们制作能快速恢复魔力的以太药。"
msgstr ""

msgctxt "c_levequest_cfg,1605_CityNPCTitle"
msgid "阿修加纳贸易公司经理"
msgstr ""

msgctxt "c_levequest_cfg,1606_QuestName"
msgid "制作委托：运货人的随身药"
msgstr ""

msgctxt "c_levequest_cfg,1606_QuestDesc"
msgid "商队遭遇魔物袭击，商人受伤，这种事一点也不罕见。为以防万一，我们互助会都让运货人带上恢复药。请为运货人制作恢复药。"
msgstr ""

msgctxt "c_levequest_cfg,1606_CityNPCTitle"
msgid "商队互助会"
msgstr ""

msgctxt "c_levequest_cfg,1607_QuestName"
msgid "制作委托：流行的巫书"
