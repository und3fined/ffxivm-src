msgid "活动规则"
msgstr ""

msgctxt "c_help_cfg,110001_SecContent"
msgid ""
"1、使用<span color=\"#d1906d\">真月魔导鲸认证密钥</>激活<span color=\"#d1906d\">坐骑-"
"真月魔导鲸</>，即可解锁返利任务。<span color=\"#d1906d\">真月魔导鲸认证密钥</>获取途径包括：商城购买、活动界面内购买"
msgstr ""

msgctxt "c_help_cfg,110002_HelpName"
msgid "巨鲸初现"
msgstr ""

msgctxt "c_help_cfg,110002_SecContent"
msgid "2、共有三项返利任务，每项任务完成后即可领取对应的奖励，且每项任务仅限完成一次"
msgstr ""

msgctxt "c_help_cfg,110003_HelpName"
msgid "巨鲸初现"
msgstr ""

msgctxt "c_help_cfg,110003_SecContent"
msgid ""
"3、本活动中购买的<span "
