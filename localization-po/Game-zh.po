msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59010902_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59011000_DialogContent"
msgid ""
"这里是弯枝牧场。要是有事就快去办，\n"
"要是没事的话就别在这里瞎转悠，\n"
"妨碍我们执勤。"
msgstr ""

