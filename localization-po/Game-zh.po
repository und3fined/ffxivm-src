msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,58996902_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,58997000_DialogContent"
msgid ""
"哎呀，抱歉。\n"
"我们这里是鬼哭队和神勇队的专卖店。\n"
"不出售冒险者用的商品。"
msgstr ""

msgctxt "c_default_dialog_cfg,58997001_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,58997002_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,58997100_DialogContent"
msgid "未使用"
msgstr ""

