msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59343000_DialogContent"
msgid ""
"呼哧……呼哧……\n"
"我是监视员 工作是监视！\n"
"迎击 击退 要另拿钱！"
msgstr ""

