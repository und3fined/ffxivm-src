msgctxt "c_default_dialog_cfg,59564900_DialogContent"
msgid ""
"没事……我还、没事……\n"
"绝不会……变成食罪灵……"
msgstr ""

msgctxt "c_default_dialog_cfg,59564901_DialogContent"
msgid "<blank>"
msgstr ""

