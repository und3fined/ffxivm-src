msgid "奇袭整备场"
msgstr ""

msgctxt "c_fate_text_cfg,1611_StoryCh"
msgid "机械化步兵大队的补给部队准备搭建魔导兵器的整备场，请破坏掉已经设置好的帝国军的整备物资。"
msgstr ""

