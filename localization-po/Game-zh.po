msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59406402_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59406500_DialogContent"
msgid ""
"<player>大人，欢迎光临。\n"
"我们为老练的冒险者以及技艺高超的工匠\n"
"准备了不少珍品。"
msgstr ""

msgctxt "c_default_dialog_cfg,59406501_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59406502_DialogContent"
msgid "<blank>"
msgstr ""

