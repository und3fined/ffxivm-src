msgctxt "c_chocobo_race_skill_display_cfg,1001_Name"
msgid "陆行鸟亢奋"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1001_Desc"
msgid ""
"吹响鸟笛激励陆行鸟，使得陆行鸟以冲刺速度向前冲刺%d秒，冲刺期间免疫一切弱化效果，并暂停体力的变化。\n"
"在冲刺结束的%d秒内陆行鸟会变得虚弱，如果虚弱期间受到弱化效果的影响，会加倍弱化效果的时长。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1002_Name"
msgid "陆行鸟振翅"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1002_Desc"
msgid ""
"陆行鸟以冲刺速度向前冲刺%d秒，冲刺期间免疫一切弱化效果，暂停体力的变化。\n"
"如果使用技能时当前的体力值在30%或70%，则不消耗体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1003_Name"
msgid "陆行鸟治疗"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1003_Desc"
msgid "恢复已消耗体力的%d%%。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1004_Name"
msgid "陆行鸟康复"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1004_Desc"
msgid "%d%%的几率解除弱化效果。当此技能成功解除弱化时，恢复%d%%的最大体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1005_Name"
msgid "陆行鸟活力"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1005_Desc"
msgid "解除加重状态，并恢复%d%%的体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1006_Name"
msgid "陆行鸟镇静"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1006_Desc"
msgid "解除失控状态，并恢复%d%%的体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1007_Name"
msgid "陆行鸟反射"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1007_Desc"
msgid ""
"%d秒内，如果自身受到来自其他玩家技能/道具的弱化效果，会将效果反射给施放者。\n"
"反射成功时会增加%d秒的无敌状态，此时陆行鸟免疫他人攻击并且超速不会扣除体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1008_Name"
msgid "陆行鸟偷取"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1008_Desc"
msgid ""
"%d%%的几率偷取前方陆行鸟的道具。成功偷取的道具可以使用两次。\n"
"如果使用技能时当前的体力值在30%或70%，则不消耗体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1009_Name"
msgid "陆行鸟沉默"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1009_Desc"
msgid ""
"在自身周围生成无法使用能力的结界，持续%d秒。\n"
"如果期间有不少于3名玩家进入结界，在结界结束时恢复最大体力的%d%%。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1010_Name"
msgid "陆行鸟震荡"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1010_Desc"
msgid ""
"在自身周围生成无法使用道具的结界，持续%d秒。\n"
"如果期间有不少于3名玩家进入结界，在结界结束时恢复%d%%的最大体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1011_Name"
msgid "陆行鸟吸收"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1011_Desc"
msgid "在自身周围生成吸收体力的结界，每秒钟从范围内的每只陆行鸟处吸收%d%%的体力，持续%d秒。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1012_Name"
msgid "道具变换"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1012_Desc"
msgid ""
"将目前持有的道具随机转换为一个不同的道具。有小概率获得惊喜道具！\n"
"如果使用技能时当前的体力值在30%或70%，则不消耗体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1013_Name"
msgid "模仿"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1013_Desc"
msgid "%d秒内，自身最近的陆行鸟使用道具或能力时，发动与之相同的效果。成功模仿时，恢复%d%%的最大体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1014_Name"
msgid "鸟羽结界"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1014_Desc"
msgid "%d秒内，不受其他陆行鸟发动的结界效果影响。鸟羽结界结束时，会恢复期间进入过的不同结界数量的%d%倍的体力值。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1015_Name"
msgid "超级冲刺"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1015_Desc"
msgid "持续加速直到疲惫，或者玩家主动取消技能。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1016_Name"
msgid "体力偷取"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1016_Desc"
msgid "与最近的陆行鸟平均体力（两者相加除以2），对于体力值低于自己的玩家无效。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1017_Name"
msgid "陆行鸟之罩"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,1017_Desc"
msgid ""
"在%d秒内保护陆行鸟不受其他弱化技能/道具影响，受到一次攻击后消失。\n"
"罩子破裂时会增加%d秒的无敌状态，此时陆行鸟免疫他人攻击并且超速不会扣除体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2001_Name"
msgid "加重耐性"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2001_Desc"
msgid "%d%%的几率使加重状态无效化。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2002_Name"
msgid "失控耐性"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2002_Desc"
msgid "%d%%的几率使失控状态无效化。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2003_Name"
msgid "体力恢复量提高"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2003_Desc"
msgid "受到恢复体力的技能/道具效果时，恢复量增加%d%%。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2004_Name"
msgid "经验值提高"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2004_Desc"
msgid "获得的经验值增加%d%%。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2005_Name"
msgid "起跑冲刺"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2005_Desc"
msgid "比赛开始时，以最高速度起跑。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2006_Name"
msgid "陆行鸟重生"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2006_Desc"
msgid "第一次体力降至25%时一次性恢复%d%%的体力。"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2007_Name"
msgid "弱化耐性"
msgstr ""

msgctxt "c_chocobo_race_skill_display_cfg,2007_Desc"
msgid "自身所受弱化效果的持续时间减少至%d%%。"
msgstr ""

