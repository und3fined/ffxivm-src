msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,58988900_DialogContent"
msgid ""
"看来格里达尼亚的商人，\n"
"对“推销”这种行为很反感呢。"
msgstr ""

msgctxt "c_default_dialog_cfg,58988901_DialogContent"
msgid ""
"把好东西展现给大家，让更多的人得到并使用它。\n"
"才是对这个物品所能表达的最大敬意，\n"
"也是作为商人的职责。"
msgstr ""

