msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59406302_DialogContent"
msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59406400_DialogContent"
msgid ""
"这里是罗薇娜商会的交易窗口。\n"
"很抱歉，我们这里采用私人推荐制。"
msgstr ""

