msgstr ""

msgctxt "c_fate_text_cfg,1620_StoryCh"
msgid "经过改良的魔导劳工再次出现在了战场上，快去破坏魔导劳工B型！"
msgstr ""

msgctxt "c_fate_text_cfg,1621_NameCh"
msgid "袭击强化兵部队"
msgstr ""

msgctxt "c_fate_text_cfg,1621_StoryCh"
msgid "为了更好操作魔导兵器而经过调整的强化兵部队出现在了战场上，请打倒率领敌军部队的狮犬狼兽型魔导装甲！"
msgstr ""

