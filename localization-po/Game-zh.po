msgid "<blank>"
msgstr ""

msgctxt "c_default_dialog_cfg,59467500_DialogContent"
msgid ""
"如果你是老练的工匠，\n"
"可以拜访归灵钟的盖丁·斯塔了解有关秘籍的详情。"
msgstr ""

